APP_NAME=ErikGratz.com
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL="https://localhost"
PLAYGROUND_ENABLED=false
APP_PORT=2080
FORWARD_APP_PORT=8090

LOG_CHANNEL=stack
LOG_LEVEL=debug

FORWARD_DB_PORT=23306
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=erikgratz
DB_USERNAME=sail
DB_PASSWORD=password

FORWARD_PG_PORT=25432
PG_HOST=pgsql
PG_PORT=5432
PG_DATABASE=erikgratz_vectors
PG_USERNAME=sail
PG_PASSWORD=password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

FORWARD_REDIS_PORT=26379
REDIS_HOST=redis
REDIS_PASSWORD=""
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

XDEBUG=false
XDEBUG_PORT=0000

# Production: set TELESCOPE_ENABLED=false if you rely on Nightwatch only.
TELESCOPE_ENABLED=true

# Queue workers (production Horizon supervisor cap). ~128 MB per worker.
HORIZON_MAX_PROCESSES=4

SIMPLE_FIN_URL=

# OpenStreetMap Nominatim (city search for Activities). Explicit search only; no autocomplete.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="ErikGratz.com Activity Map (https://erikgratz.com; contact@erikgratz.com)"
NOMINATIM_EMAIL=

# AI / chatbots (Laravel AI SDK). Domain settings: config/chatbots.php; providers: config/ai.php.
GEMINI_API_KEY=
# AI_API_KEY=  # fallback if GEMINI_API_KEY unset
CHATBOT_PROVIDER=gemini
# CHATBOT_MODEL=
CHATBOT_TIMEOUT=60
CHATBOT_EMBEDDING_PROVIDER=
CHATBOT_EMBEDDING_MODEL=text-embedding-004
CHATBOT_EMBEDDING_DIMENSIONS=768
CHATBOT_EMBEDDING_BATCH_SIZE=32
CHATBOT_EMBEDDING_TIMEOUT=60
CHATBOT_PUBLIC_RATE_LIMIT=10
CHATBOT_PUBLIC_SESSION_TTL_HOURS=24
CHATBOT_RAG_TOP_K=6
# From Sail → host Ollama: http://host.docker.internal:11434
OLLAMA_URL=http://localhost:11434

# Travel wallet promo ingest / explainer (falls back to CHATBOT_* if unset).
# TRAVEL_WALLET_AI_PROVIDER=ollama
# TRAVEL_WALLET_AI_MODEL=
# TRAVEL_WALLET_DOC_RSS=https://www.doctorofcredit.com/feed/

# Comma-separated proxy CIDRs, or * to trust all (not recommended). Empty = ignore XFF.
TRUSTED_PROXIES=
